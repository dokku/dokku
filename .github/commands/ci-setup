#!/usr/bin/env bash
set -eo pipefail

DOKKU_DOMAIN=${DOKKU_DOMAIN:="dokku.me"}
DOKKU_DOMAIN_IP="10.0.0.2"
AWS_LINK_LOCAL_RESOLVER_IP="169.254.169.253"

primary-interface() {
  declare desc="print the name of the interface holding the default route"
  ip -4 route show default | awk '{print $5; exit}'
}

interface-ip() {
  declare desc="print the first ipv4 address assigned to an interface"
  declare IFACE="$1"
  ip -4 -o addr show dev "$IFACE" | awk '{split($4, a, "/"); print a[1]; exit}'
}

release-dns-resolver() {
  declare desc="move dns resolution off an address that is about to be claimed locally"
  declare IFACE="$1" CLAIMED_IP="$2"

  resolvectl dns 2>/dev/null | grep -qw "$CLAIMED_IP" || return 0

  echo "$CLAIMED_IP is the dns resolver on this runner, switching $IFACE to $AWS_LINK_LOCAL_RESOLVER_IP"
  sudo resolvectl dns "$IFACE" "$AWS_LINK_LOCAL_RESOLVER_IP"
  sudo resolvectl flush-caches
  if resolvectl dns 2>/dev/null | grep -qw "$CLAIMED_IP"; then
    echo "!     $CLAIMED_IP is still configured as a dns resolver and cannot be claimed for $DOKKU_DOMAIN" >&2
    resolvectl dns >&2 || true
    return 1
  fi
}

verify-dns-resolution() {
  declare desc="fail when the runner can no longer resolve external hostnames"
  if ! getent hosts archive.ubuntu.com >/dev/null; then
    echo "!     dns resolution is broken after claiming $DOKKU_DOMAIN_IP" >&2
    resolvectl status >&2 || true
    return 1
  fi
}

disable-unused-apt-sources() {
  declare desc="remove apt sources ci never installs from, so an outage on one cannot fail apt-get update"
  local source_file
  for source_file in /etc/apt/sources.list.d/*; do
    [[ -f "$source_file" ]] || continue
    if grep -q "packages.microsoft.com" "$source_file"; then
      echo "removing apt source $source_file"
      sudo rm -f "$source_file"
    fi
  done
}

echo "=====> detect network interface"
ip -br addr
resolvectl dns || true
iface="$(primary-interface)"
if [[ -z "$iface" ]]; then
  echo "!     unable to detect the default network interface" >&2
  exit 1
fi
echo "interface: $iface"

echo "=====> set hostname"
hostname
internal_ip="$(interface-ip "$iface")"
echo "CI_SERVER_IP=${internal_ip}" >>"$GITHUB_ENV"
sudo hostname "$DOKKU_DOMAIN"
echo "$DOKKU_DOMAIN" | sudo tee /etc/hostname
hostname
sudo cat /etc/hostname

echo "=====> disable unused apt sources"
disable-unused-apt-sources

echo "=====> resolve $DOKKU_DOMAIN"
sudo apt -qq -y --no-install-recommends install net-tools
if [[ "$DOKKU_DOMAIN" == "dokku.me" ]]; then
  release-dns-resolver "$iface" "$DOKKU_DOMAIN_IP"
  sudo ip addr add "$DOKKU_DOMAIN_IP/24" broadcast 10.0.0.255 dev "$iface"
  verify-dns-resolution
fi

echo "=====> install ci-dependencies"
make ci-dependencies

echo "=====> setup tests"
./tests/ci/setup.sh

echo "=====> dokku cleanup:skip"
echo 'export DOKKU_SKIP_CLEANUP=true' | sudo tee /home/dokku/.dokkurc/dokku_skip_cleanup

echo "=====> dokku report"
dokku report
