#!/usr/bin/env bash
source "$PLUGIN_CORE_AVAILABLE_PATH/common/property-functions"
source "$PLUGIN_AVAILABLE_PATH/config/functions"
source "$PLUGIN_AVAILABLE_PATH/git/internal-functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

trigger-git-git-revision() {
  declare desc="fetches the current git revision value for an application"
  declare trigger="git-revision"
  declare APP="$1"
  local ENV_VAR_NAME

  ENV_VAR_NAME="$(fn-git-rev-env-var "$APP")"
  if [[ -z "$ENV_VAR_NAME" ]]; then
    return
  fi

  config_get "$APP" "$ENV_VAR_NAME" || true
}

trigger-git-git-revision "$@"
